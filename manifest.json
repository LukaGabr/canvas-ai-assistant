{
  "manifest_version": 3,
  "name": "Canvas AI Assistant",
  "version": "0.1.0",
  "description": "Ask your Canvas courses questions in plain English.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.instructure.com/*",
    "https://api.anthropic.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/pdfjs/pdf.worker.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}