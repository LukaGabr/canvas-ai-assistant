{
  "manifest_version": 3,
  "name": "Canvas AI Assistant",
  "version": "0.1.0",
  "description": "Ask your Canvas courses questions in plain English.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.instructure.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/pdfjs/pdf.worker.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}